# Copy to .env and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Local: SQLite file (the default when DATABASE_URL is not set).
# DATABASE_URL=sqlite:///./data/app.db
# Supabase: Project Settings > Database > Connection string.
#   Direct connection (IPv6 hosts):  postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#   Session pooler (IPv4 hosts):     postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:5432/postgres
# Do not use the transaction pooler (port 6543).
DATABASE_URL=

# true: the app creates the "hazard" schema and tables at start-up.
# false: run migrations/001_init.sql yourself in the Supabase SQL editor.
AUTO_CREATE_SCHEMA=true

# --- Where parsed zips are kept -------------------------------------------
# local    = folder on disk (LOCAL_DATA_DIR); only for running on one machine
# db       = a table in the same database; nothing else to configure
# supabase = a private Supabase Storage bucket
STORAGE_BACKEND=db
LOCAL_DATA_DIR=./data/blobs
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# A secret key (sb_secret_...) or the legacy service_role key. Server-side only.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=hazard-data

# --- Sessions --------------------------------------------------------------
# Required on Postgres: at least 32 random characters. The app refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_HOURS=12
# true whenever the app is served over HTTPS
COOKIE_SECURE=true

# --- First administrator (used once, when no user exists) -------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

MAX_UPLOAD_MB=200

# Serve the interactive API reference at /api/docs (off by default)
API_DOCS=false

# --- Assistant --------------------------------------------------------------
# Set a key from console.anthropic.com to switch on the assistant (natural-language changes to
# assumptions). Leave empty to hide it. AGENT_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
